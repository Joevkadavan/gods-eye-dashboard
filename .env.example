# Copy to .env only if using Docker Compose; do not commit .env.
POSTGRES_USER=godseye
POSTGRES_PASSWORD=change_me_to_a_local_secret
POSTGRES_DB=godseye
DATABASE_URL=postgresql+psycopg://godseye:change_me_to_a_local_secret@postgres:5432/godseye
MODEL_PATH=/app/backend/models/yolov8n.onnx
INFER_SIZE=416
DETECTION_CONFIDENCE=0.32
ORT_THREADS=2
MAX_CAMERAS=6
STARTUP_CAMERAS=2
RETENTION_HOURS=24
API_URL=http://backend:8000
