# Local-development defaults only. Production must use a persistent PostgreSQL URL.
APP_ENV=development
DATABASE_URL=sqlite:///../data/godseye.db
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DB_POOL_SIZE=2

# Supabase production example: use the Connect panel's Session pooler (port 5432),
# SSL, and a URL-encoded password. Enter the real URL only in Render environment settings.
# APP_ENV=production
# DATABASE_URL=postgresql://postgres.<project-ref>:<URL-encoded-password>@<session-pooler-host>:5432/postgres?sslmode=require
# FRONTEND_ORIGINS=https://gods-eye-dashboard-tau.vercel.app
# ADMIN_API_TOKEN=<generate a random value of 32+ characters; set only in Render>

# Runtime model (CPU ONNX Runtime; default is the exported dynamic YOLOv8n model)
MODEL_PATH=./models/yolov8n.onnx
INFER_SIZE=416
DETECTION_CONFIDENCE=0.32
ORT_THREADS=2
ENABLE_VIDEO_ANALYTICS=true
ENABLE_LOCAL_UPLOADS=true
STORE_LOCAL_EVIDENCE=true

# Constrained dev machine safe defaults
MAX_CAMERAS=6
RETENTION_HOURS=24
STATIONARY_SECONDS=15
CROWD_WARNING_COUNT=15
LOG_LEVEL=INFO

# Maximum number of authorized video sources started automatically at backend boot.
STARTUP_CAMERAS=2
