# Runtime model (CPU ONNX Runtime; default is the exported dynamic YOLOv8n model)
MODEL_PATH=./models/yolov8n.onnx
INFER_SIZE=416
DETECTION_CONFIDENCE=0.32
ORT_THREADS=2

# Persist to SQLite for local demo; PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/godseye
DATABASE_URL=sqlite:///../data/godseye.db

# Constrained dev machine safe defaults
MAX_CAMERAS=6
RETENTION_HOURS=24
STATIONARY_SECONDS=15
CROWD_WARNING_COUNT=15
LOG_LEVEL=INFO

# Maximum number of authorized video sources started automatically at backend boot.
STARTUP_CAMERAS=2
